{
  "mcpServers": {
    "vision": {
      "command": "node",
      "args": ["/ABSOLUTE/PATH/mimo-vision-mcp/dist/server.js"],
      "env": {
        "MIMO_API_KEY": "replace_me",
        "MIMO_BASE_URL": "https://api.xiaomimimo.com/anthropic",
        "VISION_MODEL": "mimo-v2.5",
        "VISION_ASSET_ROOT": "/ABSOLUTE/PATH/mimo-vision-mcp/assets"
      }
    }
  }
}
